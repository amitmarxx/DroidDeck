diff --git a/src/steamcompmgr.cpp b/src/steamcompmgr.cpp
index 1473148..a526eb5 100644
--- a/src/steamcompmgr.cpp
+++ b/src/steamcompmgr.cpp
@@ -65,6 +65,7 @@
 #include <sys/types.h>
 #if defined(__linux__)
 #include <sys/prctl.h>
+#include <sys/timerfd.h>
 #elif defined(__DragonFly__) || defined(__FreeBSD__)
 #include <sys/procctl.h>
 #endif
@@ -8661,6 +8662,46 @@ void update_wayland_res(const std::shared_ptr<CommitDoneList_t> &doneCommits, st
 		note_commit_fence( bKnownReady );
 	}
 
+#if defined(__linux__)
+	// Diagnostic for drivers without implicit sync (KGSL): the dma-buf poll above says "ready"
+	// while the client's GPU work may still be running. GAMESCOPE_DEBUG_COMMIT_DELAY_US=N makes
+	// every commit wait N microseconds on a timerfd (through the image waiter, like a real fence)
+	// before gamescope uses it. If unfinished frames are the problem, a few ms should hide them.
+	{
+		static long s_lDebugCommitDelayUs = -1;
+		if ( s_lDebugCommitDelayUs < 0 )
+		{
+			const char *pchDelay = getenv( "GAMESCOPE_DEBUG_COMMIT_DELAY_US" );
+			s_lDebugCommitDelayUs = pchDelay ? strtol( pchDelay, nullptr, 10 ) : 0;
+			if ( s_lDebugCommitDelayUs < 0 || s_lDebugCommitDelayUs > 100000 )
+				s_lDebugCommitDelayUs = 0;
+			if ( s_lDebugCommitDelayUs > 0 )
+				xwm_log.infof( "debug: every commit waits %ld us before use (GAMESCOPE_DEBUG_COMMIT_DELAY_US)", s_lDebugCommitDelayUs );
+		}
+		if ( s_lDebugCommitDelayUs > 0 )
+		{
+			int nTimerFd = timerfd_create( CLOCK_MONOTONIC, TFD_CLOEXEC | TFD_NONBLOCK );
+			if ( nTimerFd >= 0 )
+			{
+				struct itimerspec its = {};
+				its.it_value.tv_sec = s_lDebugCommitDelayUs / 1000000;
+				its.it_value.tv_nsec = ( s_lDebugCommitDelayUs % 1000000 ) * 1000;
+				if ( timerfd_settime( nTimerFd, 0, &its, nullptr ) == 0 )
+				{
+					if ( fence >= 0 )
+						close( fence );
+					fence = nTimerFd;
+					bKnownReady = false;
+				}
+				else
+				{
+					close( nTimerFd );
+				}
+			}
+		}
+	}
+#endif
+
 	gpuvis_trace_printf( "pushing wait for commit %lu win %lx", newCommit->commitID, w->type == steamcompmgr_win_type_t::XWAYLAND ? w->xwayland().id : 0 );
 	{
 		newCommit->SetFence( fence, mango_nudge, uMangoMsgType, doneCommits, bDroidDeckHudFrame && droiddeck_hud_frames_wanted() );
